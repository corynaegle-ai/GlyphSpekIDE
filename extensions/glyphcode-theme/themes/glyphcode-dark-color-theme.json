	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#5d6b7a", "fontStyle": "italic" }
		},
		{
			"scope": ["string", "string.quoted", "punctuation.definition.string"],
			"settings": { "foreground": "#8fd6a0" }
		},
		{
			"scope": ["constant.character.escape", "constant.other.placeholder"],
			"settings": { "foreground": "#6fb4ef" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character", "keyword.other.unit"],
			"settings": { "foreground": "#d19a66" }
		},
		{
			"scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"],
			"settings": { "foreground": "#c98bdd" }
		},
		{
			"scope": ["keyword.operator"],
			"settings": { "foreground": "#aeb9c7" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
			"settings": { "foreground": "#6fb4ef" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "entity.name.namespace"],
			"settings": { "foreground": "#e6c07b" }
		},
		{
			"scope": ["variable", "variable.other", "meta.definition.variable.name", "support.variable"],
			"settings": { "foreground": "#d7dde5" }
		},
		{
			"scope": ["variable.parameter"],
			"settings": { "foreground": "#aeb9c7" }
		},
		{
			"scope": ["variable.language", "variable.language.this"],
			"settings": { "foreground": "#a98bff", "fontStyle": "italic" }
		},
		{
			"scope": ["entity.name.tag", "punctuation.definition.tag"],
			"settings": { "foreground": "#5b9cf0" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#d9a441" }
		},
		{
			"scope": ["support.type.property-name", "meta.object-literal.key", "support.type.property-name.json"],
			"settings": { "foreground": "#6fb4ef" }
		},
		{
			"scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
			"settings": { "foreground": "#aeb9c7" }
		},
		{
			"scope": ["markup.heading", "markup.heading entity.name"],
			"settings": { "foreground": "#5b9cf0", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": { "foreground": "#8fd6a0" }
		},
		{
			"scope": ["markup.inserted"],
			"settings": { "foreground": "#3fb568" }
		},
		{
			"scope": ["markup.deleted"],
			"settings": { "foreground": "#e0544b" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#e0544b" }
		},
		{
			"scope": ["token.info-token"],
			"settings": { "foreground": "#5b9cf0" }
		},
		{
			"scope": ["token.warn-token"],
			"settings": { "foreground": "#d9a441" }
		},
		{
			"scope": ["token.error-token"],
			"settings": { "foreground": "#e0544b" }
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"parameter": "#aeb9c7",
		"property": "#6fb4ef",
		"variable.readonly": "#d19a66",
		"function": "#6fb4ef",
		"class": "#e6c07b",
		"interface": "#e6c07b",
		"enum": "#e6c07b",
		"type": "#e6c07b",
		"namespace": "#e6c07b",
		"keyword": "#c98bdd"
	}
}
